# corral-admin (the operator client) — used by the demo's one-shot mission seed.
# Pure Go (no CGO), ships static on distroless.
FROM golang:1.26.10@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/corral-admin ./cmd/corral-admin

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/corral-admin /corral-admin
ENTRYPOINT ["/corral-admin"]
