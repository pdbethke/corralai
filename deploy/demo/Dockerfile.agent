# The reference agent (corral-agent). Pure Go (no CGO) — it only speaks MCP +
# HTTP — so it builds static and ships on distroless.
FROM golang:1.26.11@sha256:957952ae74dc010608717144399a59a2c6e82ea03d63be1c7ff6577c5a135f93 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/corral-agent ./cmd/corral-agent

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/corral-agent /corral-agent
ENTRYPOINT ["/corral-agent"]
