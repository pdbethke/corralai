# SPDX-License-Identifier: Elastic-2.0
# corral pod configuration. Copy to .env and fill in. See README.md.

# ── brain ────────────────────────────────────────────────────────────────
# Where the auth-proxy forwards to. On the same box as corral.service, the
# brain listens on 127.0.0.1:9019 — but a docker container cannot reach the
# host's 127.0.0.1 via the gateway IP. See README "Reaching a loopback brain".
BRAIN_UPSTREAM=http://host-brain:9019

# A file (0600, root) holding ONLY the worker bearer token. Minted per README.
# Kept as a file (not an env var) so it stays out of `docker inspect`.
WORKER_TOKEN_FILE=/etc/corral-pod/worker-token

# ── vendor creds (populated by the auth ceremony — see README) ─────────────
# Host directories holding each CLI's logged-in credentials. Mounted read-only
# and copied into writable homes at container start.
CLAUDE_CREDS_DIR=/etc/corral-pod/creds/claude
GEMINI_CREDS_DIR=/etc/corral-pod/creds/gemini
CODEX_CREDS_DIR=/etc/corral-pod/creds/codex
COPILOT_CREDS_DIR=/etc/corral-pod/creds/copilot
GH_CONFIG_DIR=/etc/corral-pod/creds/gh

# ── model pins (attribution + avoid drift) ─────────────────────────────────
# Pin each seat to a specific model so the tape's attribution is exact and no
# worker silently competes with your interactive quota (the Fable lesson).
CLAUDE_MODEL=claude-opus-4-6
GEMINI_MODEL=gemini-2.5-pro
CODEX_MODEL=gpt-5.1-codex
COPILOT_MODEL=gpt-5

# ── tuning ─────────────────────────────────────────────────────────────────
HARNESS_TIMEOUT_SECONDS=900
HARNESS_IDLE_SECONDS=30
