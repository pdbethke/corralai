[266.597064, "o", "        from flask.signals import request_tearing_down\r\n        from flask import Flask\r\n        import warnings\r\n        from flask.globals import g\r\n        from flask.globals import app_ctx\r\n        import os\r\n        from werkzeug.test import create_environ\r\n        \r\n        def test_make_timedelta_converts_int_to_seconds():\r\n            assert _make_timedelta(10) == timedelta(seconds=10)\r\n            assert _make_timedelta(None) is None\r\n            td = timedelta(seconds=5)\r\n            assert _make_timedelta(td) is td\r\n        \r\n        def test_cli_runner_passes_kwargs():\r\n            class CustomCliRunner:\r\n                def __init__(self, app, custom_setting=None):\r\n                    self.app = app\r\n                    self.custom_setting = custom_setting\r\n        \r\n            app = flask.Flask(\"test_cli_runner_kwargs_app\")\r\n            app.test_cli_runner_class = CustomCliRunner\r\n        \r\n            runner = app.test_cli_runner(custom_setting=\"expected_val\")\r\n            assert runner.custom_setting == \"expected_val\"\r\n        \r\n        def test_corral_two_tuple_headers_as_tuple(app, client):\r\n            @app.route(\"/tuple-headers\")\r\n            def tuple_headers():\r\n                return \"hello\", ((\"X-Corral-Header\", \"tuple_value\"),)\r\n        \r\n            rv = client.get(\"/tuple-headers\")\r\n            assert rv.status_code == 200\r\n            assert rv.headers.get(\"X-Corral-Header\") == \"tuple_value\"\r\n        \r\n        \r\n        def test_corral_two_tuple_headers_as_list(app, client):\r\n            @app.route(\"/list-headers\")\r\n            def list_headers():\r\n                return \"hello\", [(\"X-Corral-Header\", \"list_value\")]\r\n        \r\n            rv = client.get(\"/list-headers\")\r\n            assert rv.status_code == 200\r\n            assert rv.headers.get(\"X-Corral-Header\") == \"list_value\"\r\n        \r\n        def test_request_tearing_down_signal_receives_exception_corral(app, client):\r\n            received_errors = []\r\n        \r\n            def handler(sender, exc=None, **kwargs):\r\n                received_errors.append(exc)\r\n        \r\n            request_tearing_down.connect(handler, app)\r\n"]
