[266.597347, "o", "            client = app.test_client()\r\n            rv = client.get(\"/\")\r\n            assert rv.data == b\"legacy_processed\"\r\n        \r\n        def test_get_send_file_max_age_timedelta_exact(app: flask.Flask) -> None:\r\n            app.config[\"SEND_FILE_MAX_AGE_DEFAULT\"] = timedelta(seconds=3600)\r\n            assert app.get_send_file_max_age(\"file.txt\") == 3600\r\n        \r\n        def test_corral_open_instance_resource_binary_and_text(tmp_path):\r\n            instance_dir = tmp_path / \"instance\"\r\n            instance_dir.mkdir()\r\n            test_file = instance_dir / \"test.txt\"\r\n        \r\n            content = \"hello world €\"\r\n            encoded_utf16 = content.encode(\"utf-16\")\r\n            test_file.write_bytes(encoded_utf16)\r\n        \r\n            app = flask.Flask(\"corral_test_app\", instance_path=str(instance_dir))\r\n        \r\n            # Binary mode check: must not pass encoding to builtin open() in binary mode\r\n            with app.open_instance_resource(\"test.txt\", mode=\"rb\") as f:\r\n                data = f.read()\r\n                assert data == encoded_utf16\r\n        \r\n            # Text mode check: must pass specified encoding to builtin open()\r\n"]
[266.597397, "o", "            with app.open_instance_resource(\"test.txt\", mode=\"r\", encoding=\"utf-16\") as f:\r\n                text = f.read()\r\n                assert text == content\r\n        \r\n        def test_corral_teardown_receives_base_exception():\r\n            app = flask.Flask(\"corral_test_app\")\r\n            captured_exceptions = []\r\n        \r\n            @app.teardown_request\r\n            def record_teardown_exception(exc):\r\n                captured_exceptions.append(exc)\r\n        \r\n            @app.route(\"/base-error\")\r\n            def trigger_base_error():\r\n                raise KeyboardInterrupt(\"corral test interrupt\")\r\n        \r\n            environ = create_environ(\"/base-error\")\r\n        \r\n            def dummy_start_response(status, headers, exc_info=None):\r\n                pass\r\n        \r\n            with pytest.raises(KeyboardInterrupt):\r\n                app.wsgi_app(environ, dummy_start_response)\r\n        \r\n            assert len(captured_exceptions) == 1\r\n            assert captured_exceptions[0] is not None\r\n            assert isinstance(captured_exceptions[0], KeyboardInterrupt)\r\n"]
