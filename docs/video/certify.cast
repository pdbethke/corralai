[266.597252, "o", "                assert application._got_first_request is True\r\n        \r\n            monkeypatch.setattr(\"werkzeug.serving.run_simple\", fake_run_simple)\r\n        \r\n            app.run()\r\n        \r\n            assert app._got_first_request is False\r\n        \r\n        def test_subclass_do_teardown_request_deprecated_signature():\r\n            teardown_executed = []\r\n        \r\n            with pytest.deprecated_call():\r\n        \r\n                class CustomFlask(flask.Flask):\r\n                    def do_teardown_request(self, exc=None):\r\n                        teardown_executed.append(True)\r\n                        super().do_teardown_request(exc)\r\n        \r\n            app = CustomFlask(\"test_app_corral\")\r\n        \r\n            @app.route(\"/\")\r\n            def index():\r\n                return \"ok\"\r\n        \r\n            client = app.test_client()\r\n            res = client.get(\"/\")\r\n            assert res.status_code == 200\r\n            assert teardown_executed == [True]\r\n        \r\n        def test_make_shell_context_contains_g() -> None:\r\n            app = flask.Flask(__name__)\r\n            context = app.make_shell_context()\r\n            assert \"g\" in context\r\n            assert context[\"g\"] is g\r\n"]
