[3.152313, "o", "              assert result == \"before_ok\"\r\n      \r\n      def test_legacy_subclass_add_ctx_passes_current_app_context():\r\n          orig_handle_exception = flask.Flask.handle_exception\r\n          try:\r\n              with warnings.catch_warnings():\r\n                  warnings.simplefilter(\"ignore\", DeprecationWarning)\r\n      \r\n                  class _LegacySubclassAppForAddCtxTest(flask.Flask):\r\n                      def handle_exception(self, e):\r\n                          return super().handle_exception(e)\r\n      \r\n              app = _LegacySubclassAppForAddCtxTest(__name__)\r\n      \r\n              @app.route(\"/\")\r\n              def index():\r\n                  raise RuntimeError(\"test error for add_ctx\")\r\n      \r\n              client = app.test_client()\r\n              rv = client.get(\"/\")\r\n              assert rv.status_code == 500\r\n          finally:\r\n              flask.Flask.handle_exception = orig_handle_exception\r\n      \r\n      def test_corral_jinja_globals_request():\r\n          app = flask.Flask(\"corral_app\")\r\n          assert app.jinja_env.globals[\"request\"] is flask.request\r\n      \r\n      def test_app_run_resets_got_first_request(monkeypatch):\r\n          monkeypatch.delenv(\"FLASK_RUN_FROM_CLI\", raising=False)\r\n          app = flask.Flask(__name__)\r\n      \r\n          @app.route(\"/\")\r\n          def index():\r\n              return \"ok\"\r\n      \r\n          def fake_run_simple(host, port, application, **options):\r\n              with application.test_client() as c:\r\n                  c.get(\"/\")\r\n              assert application._got_first_request is True\r\n      \r\n          monkeypatch.setattr(\"werkzeug.serving.run_simple\", fake_run_simple)\r\n      \r\n          app.run()\r\n      \r\n          assert app._got_first_request is False\r\n      \r\n      def test_subclass_do_teardown_request_deprecated_signature():\r\n          teardown_executed = []\r\n      \r\n          with pytest.deprecated_call():\r\n      \r\n              class CustomFlask(flask.Flask):\r\n                  def do_teardown_request(self, exc=None):\r\n                      teardown_executed.append(True)\r\n                      super().do_teardown_request(exc)\r\n      \r\n          app = CustomFlask(\"test_app_corral\")\r\n      \r\n          @app.route(\"/\")\r\n          def index():\r\n              return \"ok\"\r\n      \r\n          client = app.test_client()\r\n          res = client.get(\"/\")\r\n          assert res.status_code == 200\r\n          assert teardown_executed == [True]\r\n      \r\n      def test_make_shell_context_contains_g() -> None:\r\n          app = flask.Flask(__name__)\r\n          context = app.make_shell_context()\r\n          assert \"g\" in context\r\n          assert context[\"g\"] is g\r\n      \r\n      def test_legacy_subclass_remove_ctx_removes_app_context():\r\n          with pytest.deprecated_call():\r\n      \r\n              class LegacyApp(flask.Flask):\r\n                  def preprocess_request(self):\r\n                      return \"legacy_processed\"\r\n      \r\n          app = LegacyApp(\"legacy_app\")\r\n      \r\n          with app.test_request_context(\"/\"):\r\n              ctx = app_ctx._get_current_object()\r\n              res = app.preprocess_request(ctx)\r\n              assert res == \"legacy_processed\"\r\n      \r\n          client = app.test_client()\r\n          rv = client.get(\"/\")\r\n          assert rv.data == b\"legacy_processed\"\r\n      \r\n      def test_get_send_file_max_age_timedelta_exact(app: flask.Flask) -> None:\r\n          app.config[\"SEND_FILE_MAX_AGE_DEFAULT\"] = timedelta(seconds=3600)\r\n          assert app.get_send_file_max_age(\"file.txt\") == 3600\r\n      \r\n      def test_corral_open_instance_resource_binary_and_text(tmp_path):\r\n          instance_dir = tmp_path / \"instance\"\r\n          instance_dir.mkdir()\r\n          test_file = instance_dir / \"test.txt\"\r\n      \r\n          content = \"hello world €\"\r\n          encoded_utf16 = content.encode(\"utf-16\")\r\n          test_file.write_bytes(encoded_utf16)\r\n      \r\n          app = flask.Flask(\"corral_test_app\", instance_path=str(instance_dir))\r\n      \r\n          # Binary mode check: must not pass encoding to builtin open() in binary mode\r\n          with app.open_instance_resource(\"test.txt\", mode=\"rb\") as f:\r\n              data = f.read()\r\n              assert data == encoded_utf16\r\n      \r\n          # Text mode check: must pass specified encoding to builtin open()\r\n          with app.open_instance_resource(\"test.txt\", mode=\"r\", encoding=\"utf-16\") as f:\r\n              text = f.read()\r\n              assert text == content\r\n      \r\n      def test_corral_teardown_receives_base_exception():\r\n          app = flask.Flask(\"corral_test_app\")\r\n          captured_exceptions = []\r\n      \r\n          @app.teardown_request\r\n          def record_teardown_exception(exc):\r\n              captured_exceptions.append(exc)\r\n      \r\n          @app.route(\"/base-error\")\r\n          def trigger_base_error():\r\n              raise KeyboardInterrupt(\"corral test interrupt\")\r\n      \r\n          environ = create_environ(\"/base-error\")\r\n      \r\n          def dummy_start_response(status, headers, exc_info=None):\r\n              pass\r\n      \r\n          with pytest.raises(KeyboardInterrupt):\r\n              app.wsgi_app(environ, dummy_start_response)\r\n      \r\n          assert len(captured_exceptions) == 1\r\n          assert captured_exceptions[0] is not None\r\n          assert isinstance(captured_exceptions[0], KeyboardInterrupt)\r\n  review: none on record\r\n\r\nsrc/flask/blueprints.py\r\n  scan @ 36e4a824f340 (2026-09-08 11:27): rejected — not-selected\r\n  review: none on record\r\n\r\nsrc/flask/cli.py\r\n  scan @ 36e4a824f340 (2026-09-08 11:27): rejected — not-selected\r\n  review: 