[3.155285, "o", "\r\n          client = app.test_client()\r\n          rv = client.get(\"/\")\r\n          assert rv.status_code == 200\r\n          assert rv.data == b\"Hello World\"\r\n      \r\n      def test_add_ctx_deprecated_subclass_super_call_corral():\r\n          with warnings.catch_warnings():\r\n              warnings.simplefilter(\"ignore\", DeprecationWarning)\r\n      \r\n              class SubclassOldSignatureApp(flask.Flask):\r\n                  def handle_exception(self, e):\r\n                      return super().handle_exception(e)\r\n      \r\n          app = SubclassOldSignatureApp(\"corral_test_app\")\r\n          app.config[\"PROPAGATE_EXCEPTIONS\"] = False\r\n      \r\n          err = RuntimeError(\"corral test exception\")\r\n          with app.test_request_context(\"/\"):\r\n              response = app.handle_exception(err)\r\n              assert response.status_code == 500\r\n      \r\n      def test_app_run_resets_got_first_request_corral(monkeypatch):\r\n          monkeypatch.delenv(\"FLASK_RUN_FROM_CLI\", raising=False)\r\n          monkeypatch.setattr(werkzeug.serving, \"run_simple\", lambda *args, **kwargs: None)\r\n      \r\n          app = flask.Flask(\"test_app_corral\")\r\n          app._got_first_request = True\r\n      \r\n          app.run()\r\n      \r\n          assert app._got_first_request is False\r\n      \r\n      def test_corral_make_shell_context_includes_g():\r\n          app = flask.Flask(\"test_app_corral\")\r\n          context = app.make_shell_context()\r\n          assert \"g\" in context\r\n          assert context[\"g\"] is flask.g\r\n          assert context[\"app\"] is app\r\n      \r\n      def test_subclass_deprecated_signature_warning():\r\n          with pytest.warns(\r\n              DeprecationWarning,\r\n              match=\"The 'handle_http_exception' method now takes 'ctx: AppContext'\",\r\n          ):\r\n      \r\n              class LegacyFlaskSubclass(flask.Flask):\r\n                  def handle_http_exception(self, e):\r\n                      return super().handle_http_exception(e)\r\n      \r\n      def test_old_signature_subclass_remove_ctx_argument():\r\n          with pytest.warns(DeprecationWarning):\r\n      \r\n              class OldSignatureApp(flask.Flask):\r\n                  def preprocess_request(self):\r\n                      return \"handled_by_old_preprocess\"\r\n      \r\n          app = OldSignatureApp(__name__)\r\n      \r\n          @app.route(\"/\")\r\n          def index():\r\n              return \"hello\"\r\n      \r\n          client = app.test_client()\r\n          rv = client.get(\"/\")\r\n          assert rv.data == b\"handled_by_old_preprocess\"\r\n      \r\n      def test_open_instance_resource_mode_and_encoding(tmp_path):\r\n          app = flask.Flask(__name__, instance_path=str(tmp_path))\r\n      \r\n          # Test text mode with custom encoding\r\n          text_file = tmp_path / \"test_text.txt\"\r\n          text_content = \"Hello, World! 🐍\"\r\n          text_file.write_bytes(text_content.encode(\"utf-16\"))\r\n      \r\n          with app.open_instance_resource(\"test_text.txt\", mode=\"r\", encoding=\"utf-16\") as f:\r\n              assert f.read() == text_content\r\n      \r\n          # Test binary mode\r\n          bin_file = tmp_path / \"test_bin.bin\"\r\n          bin_content = b\"\\x00\\x01\\x02\\x03\\xff\"\r\n          bin_file.write_bytes(bin_content)\r\n      \r\n          with app.open_instance_resource(\"test_bin.bin\", mode=\"rb\") as f:\r\n              assert f.read() == bin_content\r\n  review: none on record\r\n\r\nsrc/flask/blueprints.py\r\n  scan @ 36e4a824f340 (2026-09-08 15:30): rejected — not-selected\r\n  review: none on record\r\n\r\nsrc/flask/cli.py\r\n  scan @ 36e4a824f340 (2026-09-08 15:30): rejected — not-selected\r\n  review: none on record\r\n\r\nsrc/flask/config.py\r\n  scan @ 36e4a824f340 (2026-09-08 15:30): rejected — not-selected\r\n  review: none on record\r\n\r\nsrc/fla