unner_class = CustomCliRunner\r\n      \r\n          runner = app.test_cli_runner(custom_setting=\"expected_val\")\r\n          assert runner.custom_setting == \"expected_val\"\r\n      \r\n      def test_corral_two_tuple_headers_as_tuple(app, client):\r\n          @app.route(\"/tuple-headers\")\r\n          def tuple_headers():\r\n              return \"hello\", ((\"X-Corral-Header\", \"tuple_value\"),)\r\n      \r\n          rv = client.get(\"/tuple-headers\")\r\n          assert rv.status_code == 200\r\n          assert rv.headers.get(\"X-Corral-Header\") == \"tuple_value\"\r\n      \r\n      \r\n      def test_corral_two_tuple_headers_as_list(app, client):\r\n          @app.route(\"/list-headers\")\r\n          def list_headers():\r\n              return \"hello\", [(\"X-Corral-Header\", \"list_value\")]\r\n      \r\n          rv = client.get(\"/list-headers\")\r\n          assert rv.status_code == 200\r\n          assert rv.headers.get(\"X-Corral-Header\") == \"list_value\"\r\n      \r\n      def test_request_tearing_down_signal_receives_exception_corral(app, client):\r\n          received_errors = []\r\n      \r\n          def handler(sender, exc=None, **kwargs):\r\n              received_errors.append(exc)\r\n      \r\n          request_tearing_down.connect(handler, app)\r\n          try:\r\n              @app.route(\"/fail_corral\")\r\n              def fail_corral():\r\n                  raise ValueError(\"custom error for teardown signal\")\r\n      \r\n              with pytest.raises(ValueError, match=\"custom error for teardown signal\"):\r\n                  client.get(\"/fail_corral\")\r\n      \r\n              assert len(received_errors) == 1\r\n              assert isinstance(received_errors[0], ValueError)\r\n              assert str(received_errors[0]) == \"custom error for teardown signal\"\r\n          finally:\r\n              request_tearing_down.disconnect(handler, app)\r\n      \r\n      def test_add_ctx_fallback_for_subclass_super_call():\