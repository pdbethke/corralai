[516.670451, "o", "        return \"ok\"\r\n    \r\n    class ForeignSerializer:\r\n        \"\"\"Stands in for another service / another Flask version that signs with the\r\n        same SECRET_KEY and the same 'cookie-session' salt but writes a payload the\r\n        current TaggedJSONSerializer cannot load.\"\"\"\r\n        @staticmethod\r\n        def dumps(obj, **kw):\r\n            return \"{not-json\"\r\n        @staticmethod\r\n        def loads(s, **kw):\r\n            raise ValueError(\"unused\")\r\n    \r\n    # identical key / salt / key-derivation / digest as Flask uses: the signature WILL verify\r\n    signer = app.session_interface.get_signing_serializer(app)\r\n    signer.serializer = ForeignSerializer\r\n    cookie = signer.dumps({\"user\": \"x\"})\r\n    print(\"validly-signed cookie with a foreign payload:\", cookie)\r\n    \r\n    escaped = None\r\n    with app.test_request_context(\"/\", headers={\"Cookie\": \"session=%s\" % cookie}):\r\n        try:\r\n            out = app.session_interface.open_session(app, flask.request)\r\n            print(\"no defect: open_session returned\", out)\r\n            sys.exit(1)\r\n        except BadSignature as e:\r\n            print(\"no defect: BadSignature, which open_session catches:\", e)\r\n            sys.exit(1)\r\n        except Exception as e:\r\n            escaped = e\r\n            print(\"DEFECT: open_session raised %s.%s: %s\"\r\n                  % (type(e).__module__, type(e).__name__, e))\r\n            print(\"        isinstance(e, BadSignature) =\", isinstance(e, BadSignature),\r\n                  \"| isinstance(e, BadData) =\", isinstance(e, BadData))\r\n    \r\n"]
