---
// SPDX-License-Identifier: Elastic-2.0
// The docs nav, on every page, so a reader is one click from any doc wherever
// they are. Header.astro draws it straight after the header, so every page
// with the header has it, and the /ledger/ pages get it with their copy of
// the header (integrations/ledger-chrome.mjs copies both).
//
// It is drawn in the --stage-* palette like the header, the two making one
// dark frame round the page in either theme: the ledger copy brings --stage-*
// and none of the page tokens, so a nav in --fg/--panel would lose its
// colors there. From 1024px it is a fixed column and moves the page right
// (the body rules below, which ledger-chrome copies by this nav's class); narrower, it is a drawer the header's Docs button opens
// (public/site-controls.js).
//
// Groups are <details>, open unless `collapsed` in docs-sidebar.mjs, and a
// collapsed group opens when it holds the current page.
import { DOCS_SIDEBAR, docsHref } from '../data/docs-sidebar.mjs';
interface Props {
  /** path of the page being drawn */
  current: string;
}
const { current } = Astro.props;
type Item = { label: string; slug?: string; items?: Item[]; collapsed?: boolean };
const holds = (i: Item): boolean =>
  i.slug ? docsHref(i.slug) === current : (i.items ?? []).some(holds);
---
<aside class="site-side" id="site-side" data-pagefind-ignore="all">
  <nav aria-label="Docs">
    <p class="ss-title">Docs</p>
    <ul>
      {(function list(items: Item[]): any {
        return items.map((i) =>
          i.items ? (
            <li>
              <details open={!i.collapsed || holds(i)}>
                <summary>{i.label}</summary>
                <ul>{list(i.items)}</ul>
              </details>
            </li>
          ) : (
            <li>
              <a href={docsHref(i.slug!)} aria-current={docsHref(i.slug!) === current ? 'page' : undefined}>{i.label}</a>
            </li>
          )
        );
      })(DOCS_SIDEBAR)}
    </ul>
  </nav>
</aside>

<style>
  .site-side {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 248px;
    z-index: 90;
    /* below the sticky header (z-index 100), which spans the page over it */
    padding: 72px 10px 32px 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--stage-bg);
    color: var(--stage-fg);
    border-right: 1px solid var(--stage-line);
    font-size: 14px;
  }
  .ss-title {
    margin: 0 0 8px;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stage-amber);
  }
  .site-side ul { list-style: none; margin: 0; padding: 0; }
  .site-side ul ul { padding-left: 10px; border-left: 1px solid var(--stage-line); margin: 2px 0 6px 8px; }
  .site-side li { margin: 0; }
  .site-side a {
    display: block;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--stage-muted);
    text-decoration: none;
    line-height: 1.4;
  }
  .site-side a:hover { color: var(--stage-fg); background: var(--stage-panel); }
  .site-side a[aria-current='page'] { color: var(--stage-bg); background: var(--stage-amber); font-weight: 600; }
  .site-side summary {
    cursor: pointer;
    padding: 6px 8px 4px;
    font-weight: 700;
    color: var(--stage-fg);
    line-height: 1.35;
  }
  .site-side a:focus-visible, .site-side summary:focus-visible { outline: 2px solid var(--stage-amber); outline-offset: 1px; }

  @media (min-width: 1024px) {
    :global(body):has(.site-side) { padding-left: 248px; }
    /* the header keeps the full width, over the nav's column */
    :global(body):has(.site-side) > :global(.site-header) { margin-left: -248px; }
    :global(body):has(.site-side) > :global(.site-header .sh-inner) { max-width: none; }
  }
  @media (max-width: 1023.98px) {
    .site-side {
      width: min(300px, 86vw);
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform 0.18s ease, visibility 0s linear 0.18s;
    }
    :global(html[data-site-side='open']) .site-side {
      /* over the header, which wraps to three rows on a phone */
      z-index: 110;
      padding-top: 16px;
      transform: none;
      visibility: visible;
      transition: transform 0.18s ease;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
    }
  }
</style>
