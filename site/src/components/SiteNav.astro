---
// SPDX-License-Identifier: Elastic-2.0
// The site's primary nav as pills on the dark --stage-* bar, shared by the
// marketing header and the docs header so the two draw the same links the
// same way. The parent places it (pass `class`); this owns how it looks.
import { SITE_NAV } from '../data/site-nav.mjs';
interface Props {
  /** SITE_NAV key of the current page */
  active?: string;
  class?: string;
}
const { active, class: className } = Astro.props;
---
<nav class:list={['sh-nav', className]} aria-label="Primary">
  {SITE_NAV.map((l) => (
    <a
      href={l.href}
      aria-current={active === l.key ? 'page' : undefined}
      target={l.external ? '_blank' : undefined}
      rel={l.external ? 'noopener noreferrer' : undefined}
    >{l.label}</a>
  ))}
</nav>

<style>
  .sh-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .sh-nav a {
    color: var(--stage-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    padding: 6px 10px;
    border-radius: 7px;
    white-space: nowrap;
    transition: color 0.12s ease, background 0.12s ease;
  }
  .sh-nav a:hover { color: var(--stage-fg); background: var(--stage-panel); }
  .sh-nav a[aria-current='page'] { color: var(--stage-bg); background: var(--stage-amber); }
</style>
