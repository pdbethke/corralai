---
// SPDX-License-Identifier: Elastic-2.0
// Overrides Starlight's Header so /docs is no longer a nav dead end: it keeps the
// full docs header (site title, search, theme, social) AND adds the marketing
// site-nav inline (the same SiteNav and StarLink the marketing header draws, so
// the links and their pills cannot differ), and /docs reads as one continuous
// site with /, /recordings, /field-notes. Search and theme reuse Starlight's
// own built-in components (virtual: imports resolve to the
// configured overrides/defaults) so search + theme + social behave exactly as
// stock. Below Starlight's lg breakpoint the inline nav (seven links) would not
// fit beside search, so it hides; the same destinations are the sidebar's
// "Site" group (see astro.config), which is on screen there or in the mobile menu.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import config from 'virtual:starlight/user-config';
import SiteNav from './SiteNav.astro';
import StarLink from './StarLink.astro';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-flex">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-hidden lg:sl-flex">
		<SiteNav active="docs" />
	</div>
	<div class="search-wrapper sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex right-group">
		<StarLink />
		<ThemeSelect />
	</div>
</div>

<style>
	.header {
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}
	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	.search-wrapper {
		flex: 1 1 auto;
		justify-content: flex-end;
	}
	.right-group {
		gap: 10px;
		align-items: center;
	}
</style>
