---
// SPDX-License-Identifier: Elastic-2.0
// One docs page: the site's own Header and SiteFooter around a sidebar, the
// page, and its contents. Starlight drew /docs until 2026-10-22; it had its
// own header, palette and theme switch, so the docs read as a second site
// however closely we restyled it, and its search covered only the docs.
// Search is now the header's (SiteSearch), over the whole site.
//
// Layout: sidebar | article | on-this-page at >= 1180px; the contents column
// drops below that, and under 900px the sidebar folds into a "Docs menu"
// disclosure above the article. Chrome is data-pagefind-ignore so a search
// matches what a page says, not its sidebar.
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { docsHref, sidebarPages } from '../../data/docs-sidebar.mjs';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('docs');
  return pages.map((page) => ({
    params: { slug: docsHref(page.id).replace(/^\/docs\/?|\/$/g, '') || undefined },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const href = docsHref(page.id);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const order = sidebarPages();
const at = order.findIndex((p) => docsHref(p.slug) === href);
const prev = at > 0 ? order[at - 1] : undefined;
const next = at >= 0 && at < order.length - 1 ? order[at + 1] : undefined;

const url = `https://corralai.dev${href}`;
const title = `${page.data.title} — Corralai docs`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () { try { var t = localStorage.getItem('corralai-site-theme') || 'light'; document.documentElement.setAttribute('data-theme', t); var ct = localStorage.getItem('corralai-cockpit-theme'); if (ct) document.documentElement.setAttribute('data-cockpit-theme', ct); } catch (e) {} })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={page.data.description} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={page.data.title} />
  <meta property="og:description" content={page.data.description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content="https://corralai.dev/og-image.png" />
</head>
<body>
  <Header active="docs" />
  <div class="docs-shell">
    <DocsSidebar current={href} />
    <main class="docs-main">
      <article class="docs-article">
        <h1>{page.data.title}</h1>
        <div class="prose">
          <Content />
        </div>
      </article>
      {(prev || next) && (
        <nav class="docs-pager" aria-label="Previous and next" data-pagefind-ignore="all">
          {prev ? <a class="prev" href={docsHref(prev.slug)} rel="prev"><span>Previous</span>{prev.label}</a> : <span />}
          {next && <a class="next" href={docsHref(next.slug)} rel="next"><span>Next</span>{next.label}</a>}
        </nav>
      )}
    </main>
    {toc.length > 1 && (
      <nav class="docs-toc" aria-label="On this page" data-pagefind-ignore="all">
        <p class="docs-toc-title">On this page</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
  <SiteFooter />
</body>
</html>

<style>
  .docs-shell {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    column-gap: 40px;
  }
  .docs-main { min-width: 0; padding: 36px 0 56px; max-width: 780px; }
  .docs-article h1 { font-size: clamp(28px, 4.5vw, 38px); line-height: 1.15; margin: 0 0 24px; }

  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
  }
  .docs-pager a {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
    font-weight: 600;
  }
  .docs-pager a:hover { border-color: var(--amber); }
  .docs-pager span { display: block; font-size: 13px; font-weight: 400; color: var(--muted); }
  .docs-pager .next { text-align: right; grid-column: 2; }

  .docs-toc { display: none; }
  @media (min-width: 1180px) {
    .docs-shell { grid-template-columns: 250px minmax(0, 1fr) 220px; }
    .docs-toc {
      display: block;
      position: sticky;
      top: 72px;
      align-self: start;
      max-height: calc(100vh - 90px);
      overflow-y: auto;
      padding: 36px 0;
      font-size: 13px;
    }
  }
  .docs-toc-title { margin: 0 0 8px; font-weight: 700; color: var(--fg); }
  .docs-toc ul { list-style: none; margin: 0; padding: 0; }
  .docs-toc li { margin: 0 0 6px; }
  .docs-toc li.d3 { padding-left: 12px; }
  .docs-toc a { color: var(--muted); text-decoration: none; }
  .docs-toc a:hover { color: var(--amber); }

  @media (max-width: 899px) {
    .docs-shell { display: block; }
    .docs-main { padding-top: 20px; }
  }
</style>
