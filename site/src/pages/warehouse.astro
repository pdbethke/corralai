---
// SPDX-License-Identifier: Elastic-2.0
// The accountability warehouse: DuckDB (WebAssembly) running IN THE BROWSER
// against corral's REAL audit dataset. corral stores every audit as a signed,
// hash-linked record + per-model execution telemetry in DuckDB; this page ships
// two tiny parquet extracts (self-hosted) and runs live SQL client-side. The
// DuckDB runtime is loaded from jsDelivr on first query (the wasm is >25MiB, over
// Cloudflare Pages' file cap — and loading the runtime from a CDN is the norm).
// The same schema federates to MotherDuck (corral/internal/fleet) for streaming-live.
import '../styles/global.css';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
// Row counts come from the generator, never from a human retyping them: the
// footer used to describe a dataset the files had moved on from.
import warehouse from '../data/warehouse-manifest.json';

const rows = (t: string) => (warehouse.tables as Record<string, number>)[t]?.toLocaleString() ?? '?';
const withheldRecords = warehouse.withheld.audit_ledger;
const withheldSeats = warehouse.withheld.bug_catches;

const PRESETS = [
  {
    label: 'Which files keep shipping demonstrated gaps',
    sql: `-- The cross-project question a single pull request cannot answer.\n-- A proven gap is a survivor the herd then KILLED with a test it wrote and\n-- ran: a demonstrated bug, not a proportion. Counting those across repos is\n-- legitimate arithmetic — averaging kill rates across them is not, because a\n-- dense function and a small accessor are not the same measurement.\nSELECT l.repo,\n       COUNT(DISTINCT l.id)      AS audits,\n       SUM(b.mutants_planted)    AS planted,\n       SUM(b.mutants_killed)     AS killed\nFROM audit_ledger l JOIN bug_catches b ON b.record_id = l.id\nGROUP BY 1\nORDER BY planted DESC;`,
  },
  {
    label: 'Is one file drifting, or is that just the sampling?',
    sql: `-- The reason a warehouse exists rather than a screenshot. Mutants are\n-- generated fresh per run, so one number is a SAMPLE: on this project's own\n-- data the same unchanged file has scored 0.375 and 0.525, and a weakened\n-- suite once scored HIGHER than it had a moment earlier.\n-- A spread tells you whether a change is real. A single figure cannot.\nSELECT scan_id, path, kill_rate, survivors, proven_missed\nFROM scan_files\nWHERE path = 'src/flask/cli.py'\nORDER BY scan_id;`,
  },
  {
    label: 'Which model catches bugs, in which role',
    sql: `-- The scorecard the replay's panes link to. Every row is EXECUTION:\n-- mutants a seat planted, and how many the developer's suite killed.\n-- A test-critic plants nothing, so its planted count is 0 by design --\n-- it reads the suite, it never gates the verdict.\nSELECT model, role, COUNT(*) AS seats, SUM(mutants_planted) AS planted,\n       SUM(mutants_killed) AS killed,\n       ROUND(100.0*SUM(mutants_killed)/NULLIF(SUM(mutants_planted),0),1) AS caught_pct\nFROM bug_catches\nGROUP BY 1,2\nORDER BY planted DESC;`,
  },
  {
    label: 'Every signed verdict, by repo',
    sql: `-- One row per repo per verdict, joined from the signed ledger to the\n-- per-seat telemetry. Libraries we did not write sit beside our own code,\n-- and corral's own repo is not the best score on the board.\nSELECT l.repo, IF(l.certified,'CERTIFIED','needs-review') AS verdict,\n       COUNT(DISTINCT l.id) AS records,\n       SUM(b.mutants_killed) AS killed, SUM(b.mutants_planted) AS planted,\n       ROUND(100.0*SUM(b.mutants_killed)/SUM(b.mutants_planted),1) AS kill_pct\nFROM audit_ledger l JOIN bug_catches b ON b.record_id = l.id\nGROUP BY 1,2\nORDER BY kill_pct DESC;`,
  },
  {
    label: 'Every audited file had a proven gap',
    sql: `-- 10 files audited across 6 scans of Flask. A survivor is a planted fault\n-- the suite did not catch. proven_missed counts only the survivors corral\n-- then killed with a test it WROTE and RAN — not an opinion, an execution.\nSELECT scan_id, path, kill_rate, survivors, proven_missed\nFROM scan_files\nWHERE disposition = 'audited'\nORDER BY proven_missed DESC;`,
  },
  {
    label: 'The same file, six times',
    sql: '-- src/flask/cli.py, audited six times. Scans 1-5 are a deliberate replicate\n-- series -- same file, same suite, nothing changed but the seed. Scan 6 hit it\n-- again inside a 5-file sweep. The kill rate barely moves (0.375..0.525) while\n-- the proven-gap count swings 1..15. Generator variance is larger than most\n-- effects you would try to measure, which is why a comparison needs a FIXED\n-- mutant set -- and why a single run is evidence, not a grade.\nSELECT scan_id, kill_rate, survivors, proven_missed\nFROM scan_files\nWHERE path = \'src/flask/cli.py\'\nORDER BY scan_id;',
  },
  {
    label: 'The honest denominator',
    sql: `-- What a whole-repo scan REJECTED, and why. 241 files, 9 candidates,\n-- 10 audited seats. A tool that hid this would look far more capable\n-- than it is: 'no-paired-test' is coverage corral cannot yet pair by\n-- filename, and it is counted, not quietly dropped.\nSELECT disposition, reason, COUNT(*) AS files\nFROM scan_files\nGROUP BY 1,2\nORDER BY files DESC;`,
  },
  {
    label: 'Scan-level receipts',
    sql: `-- Six real scans of Flask on the workspace substrate. kill_rate here is\n-- the scan aggregate; 'audited' is how many files actually got graded,\n-- bounded on purpose because an audit costs (mutants x suite runtime).\nSELECT id, ts, repo, substrate, total_files, candidates, audited, kill_rate\nFROM scans\nORDER BY id;`,
  },
];
const initialSql = PRESETS[0].sql;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () { try { var t = localStorage.getItem('corralai-site-theme') || 'light'; document.documentElement.setAttribute('data-theme', t); } catch (e) {} })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Corralai — the accountability warehouse (DuckDB in your browser)</title>
  <meta name="description" content="Query corral's real audit ledger with DuckDB running in WebAssembly, client-side. Signed records + execution-proven telemetry, live SQL, no backend — the same schema that federates to MotherDuck." />
</head>
<body>
  <Header active="warehouse" />
  <div class="section">
    <h1>The accountability warehouse</h1>
    <p class="lede">
      corral records every scan — <strong>what it audited, what it rejected, and
      why</strong> — natively in <strong>DuckDB</strong>. This page runs DuckDB
      itself, compiled to <strong>WebAssembly</strong>, <em>in your browser</em>,
      against a real dataset: six scans of <strong>Flask</strong>, a library we
      didn't write. Real SQL, no backend. Query the rejections as readily as the
      results — the point of a ledger is that it also records the parts that
      don't flatter you. This page is <strong>our</strong> audit data, and the
      point is that you can have the same table of your own: `corral certify`
      takes <code>--push &lt;target&gt;</code> and appends every run's per-file
      verdict to a DuckDB <em>you</em> own — a path, or <code>md:&lt;db&gt;</code>
      for MotherDuck. There is no hosted tier and nothing is collected; your key,
      your runner, your warehouse. The same schema federates to <strong>MotherDuck</strong>
      (a DSN flip) as a shared warehouse across a distributed dev shop.
    </p>

    <div class="presets">
      {PRESETS.map((p, i) => (
        <button class="preset" data-sql={p.sql} data-i={i}>{p.label}</button>
      ))}
    </div>

    <div class="editor">
      <textarea id="sql" spellcheck="false" aria-label="SQL query">{initialSql}</textarea>
      <div class="editrow">
        <button id="run" disabled>Loading DuckDB…</button>
        <span id="status">booting DuckDB-WASM…</span>
      </div>
    </div>

    <div id="out" class="out"></div>

    <p class="foot">
      <strong>Tables:</strong> <code>audit_ledger</code> ({rows('audit_ledger')} signed
      verdicts) · <code>bug_catches</code> ({rows('bug_catches')} per-seat rows — which
      model planted what, in which role, and how many the suite killed) ·
      <code>scans</code> ({rows('scans')} whole-repo scans) · <code>scan_files</code>
      ({rows('scan_files')} per-file rows — every candidate the scan considered,
      audited or rejected, with the reason). Four real DuckDB tables, shipped as
      parquet and queried client-side.
      <br /><br />
      <strong>These are not the table `--push` writes.</strong> The four above
      are corral's own historical stores, hand-exported from the machine that
      produced them: a signed verdict per audit, a row per model seat, and a
      whole-repo scan series. A run with <code>--push</code> writes something
      newer and simpler — one <code>corral_audits</code> row per audited file,
      carrying the kill rate, the survivors, the proven gaps, the qualifier
      flags that say what a zero means, the thresholds, the roster, and the
      sha256 of the signed statement it came from. Same subject, different
      shape, and the <a href="/docs/warehouse/">documentation</a> describes that
      one, because it is the shape you get. This page has not been backfilled
      into it, and saying so is cheaper than pretending the two are the same
      table.

      <strong>What is not here, and why.</strong> The ledger on the machine that
      produced these extracts also records audits of PRIVATE repositories. Those
      are withheld by an explicit allowlist in
      <code>scripts/build-warehouse-parquet.py</code> — <strong>{withheldRecords} verdicts
      and {withheldSeats} seat rows</strong>, counted here rather than quietly dropped, because a
      truncated table that does not say so looks more complete than it is. The
      scan series was <strong>recorded 2026-08-02</strong> against
      <a href="https://github.com/pallets/flask">Flask</a> — a library we did not
      write — on the <code>workspace</code> substrate.
      <code>corral fleet</code> federates the same schema to MotherDuck for
      streaming-live. <a href="/recordings/">See the audits these rows came from →</a>
    </p>
  </div>
  <SiteFooter />
</body>
</html>

<script>
  import * as duckdb from '@duckdb/duckdb-wasm';

  const statusEl = document.getElementById('status');
  const runBtn = document.getElementById('run') as HTMLButtonElement;
  const sqlEl = document.getElementById('sql') as HTMLTextAreaElement;
  const outEl = document.getElementById('out');

  let conn: any = null;

  function esc(s: any) {
    return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  }

  function renderTable(rows: any[], cols: string[], ms: number) {
    if (!rows.length) { outEl!.innerHTML = '<p class="empty">0 rows.</p>'; return; }
    let h = '<div class="tablewrap"><table><thead><tr>';
    for (const c of cols) h += '<th>' + esc(c) + '</th>';
    h += '</tr></thead><tbody>';
    for (const r of rows) {
      h += '<tr>';
      for (const c of cols) {
        const v = r[c];
        const cls = typeof v === 'number' || typeof v === 'bigint' ? ' class="num"' : '';
        h += '<td' + cls + '>' + (v === null || v === undefined ? '<span class="null">∅</span>' : esc(v)) + '</td>';
      }
      h += '</tr>';
    }
    h += '</tbody></table></div><p class="meta">' + rows.length + ' row' + (rows.length === 1 ? '' : 's') + ' · ' + ms + ' ms · DuckDB-WASM, in your browser</p>';
    outEl!.innerHTML = h;
  }

  async function runQuery() {
    if (!conn) return;
    const sql = sqlEl.value.trim();
    if (!sql) return;
    runBtn.disabled = true;
    const t0 = performance.now();
    try {
      const res = await conn.query(sql);
      const cols = res.schema.fields.map((f: any) => f.name);
      const rows = res.toArray().map((r: any) => r.toJSON());
      renderTable(rows, cols, Math.round(performance.now() - t0));
      statusEl!.textContent = 'ready';
    } catch (e: any) {
      outEl!.innerHTML = '<p class="err">' + esc(e.message || String(e)) + '</p>';
      statusEl!.textContent = 'ready';
    }
    runBtn.disabled = false;
  }

  async function boot() {
    try {
      // Load the DuckDB runtime from jsDelivr (the wasm is >25MiB, over Cloudflare
      // Pages' per-file cap; loading the runtime from a CDN is standard). Data
      // stays local: two same-origin parquet extracts registered below.
      const bundles = duckdb.getJsDelivrBundles();
      const bundle = await duckdb.selectBundle(bundles);
      const worker = await duckdb.createWorker(bundle.mainWorker!);
      const db = new duckdb.AsyncDuckDB(new duckdb.ConsoleLogger(), worker);
      await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
      conn = await db.connect();

      for (const t of ['scans', 'scan_files', 'audit_ledger', 'bug_catches']) {
        const buf = new Uint8Array(await (await fetch('/data/' + t + '.parquet')).arrayBuffer());
        await db.registerFileBuffer(t + '.parquet', buf);
        await conn.query("CREATE VIEW " + t + " AS SELECT * FROM '" + t + ".parquet'");
      }

      runBtn.textContent = 'Run query';
      runBtn.disabled = false;
      statusEl!.textContent = 'ready — DuckDB is live in your browser';
      runBtn.addEventListener('click', runQuery);
      sqlEl.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') runQuery(); });
      for (const b of document.querySelectorAll('.preset')) {
        b.addEventListener('click', () => { sqlEl.value = (b as HTMLElement).dataset.sql || ''; runQuery(); });
      }
      // A ?q=<sql> link (e.g. from a cockpit view — "see this query run")
      // pre-fills and runs that exact query, so a claim is one click from its
      // grounding.
      const urlQ = new URLSearchParams(location.search).get('q');
      if (urlQ) sqlEl.value = urlQ;
      runQuery(); // run the URL query, or the default preset
    } catch (e: any) {
      statusEl!.textContent = 'DuckDB failed to load: ' + (e.message || String(e));
    }
  }
  boot();
</script>

<style>
  .section { max-width: 1000px; }
  .lede { max-width: 780px; font-size: 1.08rem; line-height: 1.55; color: var(--fg); }
  .presets { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 14px; }
  .preset { background: var(--panel); border: 1px solid var(--line); color: var(--fg); border-radius: 999px; padding: 6px 14px; font-size: 0.88rem; cursor: pointer; }
  .preset:hover { border-color: var(--amber); color: var(--amber); }
  .editor { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--panel); }
  #sql { width: 100%; box-sizing: border-box; border: 0; background: transparent; color: var(--fg); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.55; padding: 14px 16px; min-height: 150px; resize: vertical; outline: none; }
  .editrow { display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-top: 1px solid var(--line); }
  #run { background: var(--amber); color: #fff; border: 0; border-radius: 6px; padding: 8px 18px; font-weight: 600; cursor: pointer; }
  #run:disabled { opacity: 0.55; cursor: default; }
  #status { color: var(--muted); font-size: 0.86rem; }
  .out { margin-top: 18px; }
  .tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
  .out table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .out th, .out td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .out th { color: var(--amber); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; background: var(--sel); }
  .out td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .out .null { color: var(--muted); }
  .out .meta { color: var(--muted); font-size: 0.82rem; margin: 8px 2px 0; }
  .out .err { color: var(--amber); font-family: ui-monospace, monospace; font-size: 0.86rem; padding: 12px; border: 1px solid var(--amber); border-radius: 8px; background: var(--sel); white-space: pre-wrap; }
  .out .empty { color: var(--muted); }
  .foot { margin-top: 24px; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .foot code { background: var(--sel); border-radius: 4px; padding: 1px 5px; font-size: 0.85em; }
  .foot a { color: var(--amber); font-weight: 600; text-decoration: none; }
</style>
